# Keep real credentials in .env; never commit them.
# DeepSeek shortcut (the client uses its Anthropic-compatible endpoint):
DEEPSEEK_API_KEY=your_deepseek_api_key
MODEL_ID=deepseek-flash

# Optional fallback model on the same API endpoint:
# FALLBACK_MODEL_ID=your_fallback_model_id

# Alternatively use Anthropic or another Anthropic-compatible endpoint.
# ANTHROPIC_API_KEY takes priority over DEEPSEEK_API_KEY when both are set.
# ANTHROPIC_API_KEY=your_api_key
# ANTHROPIC_BASE_URL=https://your-provider.example/anthropic
# Set MODEL_ID to a model supported by the selected endpoint.
