{
    "version":  "0.2.0",
    "configurations":  [
                           {
                               "name":  "Multi-Agent Team: selected Python interpreter",
                               "type":  "debugpy",
                               "request":  "launch",
                               "program":  "${workspaceFolder}/main.py",
                               "cwd":  "${workspaceFolder}",
                               "console":  "integratedTerminal",
                               "args":  [
                                            "--env-file",
                                            "${workspaceFolder}/.env"
                                        ],
                               "justMyCode":  true
                           }
                       ]
}
